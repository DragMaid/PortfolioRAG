# Copy to .env for local work. Everything here has a default except the encryption key,
# which has to match the API and so cannot have one.

# The same database the API uses. Port 5433 is what docker-compose publishes.
RAG_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio

# Base64 of the 32 bytes the API seals provider keys with — the value of Llm:EncryptionKey
# in appsettings. THIS MUST MATCH EXACTLY: a mismatch is not a degraded mode, it is every
# analysis failing at the last moment with an error about a provider key.
#
# The value below is the development one from appsettings.Development.json. Generate a real
# one with:  openssl rand -base64 32
RAG_ENCRYPTION_KEY=ZGV2LW9ubHktc2VhbC1rZXktbm90LWZvci1wcm9kISE=

# --- the rest are defaults, shown so they can be found ---

# Embeddings run in-process. The width must match the RagDocuments.Embedding column, which
# the migration fixed at 384; changing the model means migrating the column and re-indexing.
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_EMBEDDING_DIMENSIONS=384

# Retrieval. dense_k/sparse_k are per requirement; context_passages is what reaches the
# model and is most of the prompt's cost.
# RAG_DENSE_K=12
# RAG_SPARSE_K=12
# RAG_MMR_LAMBDA=0.65
# RAG_CONTEXT_PASSAGES=24

# Effort per stage. Extraction is close to a parsing task; assessment is the one that reasons.
# RAG_EXTRACTION_EFFORT=medium
# RAG_ASSESSMENT_EFFORT=high

# How long a claimed job is held before another worker may take it. Must exceed the slowest
# job comfortably, or a long analysis gets run twice.
# RAG_LEASE_SECONDS=600

# RAG_LOG_LEVEL=INFO
# RAG_LOG_JSON=false
