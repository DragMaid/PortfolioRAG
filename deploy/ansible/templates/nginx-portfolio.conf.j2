# {{ ansible_managed }}
# Portfolio: frontend on {{ portfolio_domain }}, API on {{ portfolio_api_domain }}.
# Both upstreams are loopback-only ports published by docker-compose.prod.yml.

server {
    listen 80;
    listen [::]:80;
    server_name {{ portfolio_domain }} {{ portfolio_api_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ portfolio_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ portfolio_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ portfolio_domain }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:{{ frontend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade_portfolio;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ portfolio_api_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ portfolio_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ portfolio_domain }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size {{ client_max_body_size }};

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Media uploads stream through to B2, and job-fit analysis can take a while.
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# Named per-site: a `map` is http-global, so a generic name could clash with another vhost.
map $http_upgrade $connection_upgrade_portfolio {
    default upgrade;
    ''      close;
}
