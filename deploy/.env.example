# Production environment for docker-compose.prod.yml.
#
# The whole file (minus IMAGE_PREFIX / IMAGE_TAG, which the workflow appends) is stored as
# the `PROD_ENV_FILE` secret on the GitHub `production` environment and written to
# /opt/portfolio/.env on every deploy. Edit the secret, not the file on the server.
#
# Generate the random values with the commands shown. Hex keeps them safe inside the
# connection strings they are spliced into.

# Public hostname of the frontend. The API is served at api.<this> (Traefik routes both).
SITE_DOMAIN=example.com

# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_KEY=
# openssl rand -base64 32   — 32 bytes, base64. Shared by the API and the rag worker.
# NEVER change it once authors have saved provider keys: they are sealed with it.
LLM_ENCRYPTION_KEY=
# openssl rand -hex 32
ANALYTICS_VISITOR_SALT=

# Backblaze B2 application key scoped to the one bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional: Google sign-in for the studio.
GOOGLE_CLIENT_ID=

# Optional: the relay that carries email verification codes. Only accounts that sign up
# with a password ever need one — Google has already vouched for the addresses it sends.
# Leave SMTP_HOST empty and the codes go to the API's log instead of an inbox, which is
# fine for a deployment where you are the only account and a dead end for anyone else.
#
# SMTP_PORT 587 means STARTTLS; for 465 set SMTP_USE_STARTTLS=false. FROM_ADDRESS has to
# be one the provider lets you send as, or the relay will refuse the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Portfolio

RAG_LOG_LEVEL=INFO
