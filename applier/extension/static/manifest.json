{
  "manifest_version": 3,
  "name": "applier autofill",
  "version": "0.1.0",
  "description": "Fills job application forms from applier's facts and the answers you gave before, and asks you about the rest.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "applier — fill this page" }
}
