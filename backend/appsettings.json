{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "portfolio-backend",
    "Audience": "portfolio-frontend",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Storage": {
    "Provider": "Backblaze"
  },
  "Backblaze": {
    "KeyId": "",
    "ApplicationKey": "",
    "BucketName": "",
    "DownloadTokenSeconds": 3600
  },
  "S3": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "",
    "ServiceUrl": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "DownloadUrlSeconds": 3600
  },
  "Analytics": {
    "SelfHosts": []
  },
  "Llm": {
    "EncryptionKey": "",
    "ValidationTimeoutSeconds": 15,
    "DefaultModel": "claude-opus-5",
    "MaxJobDescriptionChars": 20000,
    "AnthropicBaseUrl": "https://api.anthropic.com",
    "OpenAIDefaultModel": "gpt-6-astra",
    "OpenAIBaseUrl": "https://api.openai.com",
    "GeminiDefaultModel": "gemini-3.8-flash",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com"
  },
  "Media": {
    "MaxImageBytes": 10485760,
    "MaxVideoBytes": 104857600,
    "MaxImagePixels": 50000000,
    "MaxImageDimension": 2048,
    "MaxAvatarDimension": 512,
    "ImageQuality": 80
  }
